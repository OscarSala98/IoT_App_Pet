{
  "expo": {
    "name": "Pet Monitor",
    "slug": "pet-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.oscarsala04.petmonitor",
      "usesCleartextTraffic": true
    },
    "web": {},
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "51b9ef4a-b80a-4b85-8fe0-2fbfb52a1d9b"
      }
    }
  }
}
